# ── Database ──────────────────────────────────────────────────────────────
# Neon pooled connection string. Leave empty to run on the in-memory demo set.
DATABASE_URL=

# ── Encryption ────────────────────────────────────────────────────────────
# 32 random bytes, base64. Generate once:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# LOSE THIS AND EVERY PROVIDER KEY IN THE DATABASE IS UNRECOVERABLE.
KEY_ENC_MASTER=

# ── Router auth ───────────────────────────────────────────────────────────
# Bearer token clients send to /v1/chat/completions. Generate with:
#   node -e "console.log('sk-' + require('crypto').randomBytes(24).toString('hex'))"
ROUTER_KEY=

# ── Dashboard auth ────────────────────────────────────────────────────────
DASHBOARD_PASSWORD=
# Secret used to sign the dashboard session cookie.
SESSION_SECRET=

# ── Provider keys (add as you obtain them) ────────────────────────────────
# Keys are added through the dashboard, encrypted at rest in Neon.
# These env vars are only used by scripts/sync-models.ts for a first seed.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=
CHUTES_API_KEY=
SAMBANOVA_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
